# ---- build artifacts (regenerated by make-release.bat) ----
release/

# ---- local-only: personal & per-house — never leaves your machine ----
# secrets (should never have been tracked; if you forked before this
# line existed, ROTATE any token that ever lived in .env.local)
.env.local
# your house profiles + which one is default (houses/example.cmd is
# the tracked template)
houses/*.cmd
!houses/example.cmd
houses/default.txt
# pulled config snapshots (pull-my-config.bat) — your home's layout
houses/*/

# ---- local scratch, never repo material ----
_to_delete/
_survey2/
# markdown-editor pasted-image backups (tool scratch, not repo material)
.md4h/

# raw per-device Fully exports carry your LAN URL + encrypted PINs —
# the tracked truth is remotes/fully/remote-fully-settings.json
remotes/fully/astrion-fully-settings.json
remotes/fully/*-fully-settings-raw.json

# ---- remote tooling local state (never repo material) ----
# your named remotes + their LAN addresses (units.example.json is the template)
remotes/units.json
# the picker's remembered last device
remotes/.last-target
# your manual safety copy of the remotes tree
remotes-snapshot/
