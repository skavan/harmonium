  "sequences": {
    "firetv_on": {
      "name": "Fire TV On",
      "actions": [
        {
          "alias": "Set activity state",
          "action": "harmonium.set_activity",
          "data": {
            "activity": "watch_firetv"
          }
        },
        {
          "alias": "Wake Fire TV if asleep (non-disruptive, best effort)",
          "action": "media_player.turn_on",
          "continue_on_error": true,
          "target": {
            "entity_id": "media_player.fire_tv_family_192_168_1_65"
          }
        },
        {
          "alias": "Cold start only: wake the Samsung",
          "if": [
            {
              "condition": "state",
              "entity_id": "media_player.sts_samsung_q90_porch",
              "state": "off"
            }
          ],
          "then": [
            {
              "alias": "Wake TV via wired WOL (reliable from standby)",
              "action": "button.press",
              "continue_on_error": true,
              "target": {
                "entity_id": "button.samsung_wired_wol_d4_9d_c0_2c_e5_bf"
              }
            },
            {
              "alias": "Wake TV via remote entity (best effort)",
              "action": "remote.turn_on",
              "continue_on_error": true,
              "target": {
                "entity_id": "remote.sts_samsung_q90_porch"
              }
            },
            {
              "alias": "Wait for the TV to report on (up to 6s)",
              "wait_for_trigger": [
                {
                  "trigger": "state",
                  "entity_id": "media_player.sts_samsung_q90_porch",
                  "to": "on"
                }
              ],
              "timeout": {
                "seconds": 6
              },
              "continue_on_timeout": true
            },
            {
              "alias": "Let the TV finish waking before the source switch",
              "delay": {
                "seconds": 1
              }
            }
          ]
        },
        {
          "alias": "Switch TV input ONLY if not already on the Fire TV",
          "if": [
            {
              "condition": "not",
              "conditions": [
                {
                  "condition": "state",
                  "entity_id": "media_player.sts_samsung_q90_porch",
                  "attribute": "source",
                  "state": [
                    "Fire TV",
                    "TV/HDMI"
                  ]
                }
              ]
            }
          ],
          "then": [
            {
              "alias": "Switch TV input to Fire TV (best effort)",
              "action": "media_player.select_source",
              "continue_on_error": true,
              "data": {
                "source": "Fire TV"
              },
              "target": {
                "entity_id": "media_player.sts_samsung_q90_porch"
              }
            }
          ]
        }
      ],
      "room": "porch"
    },
    "smart_tv_on": {
      "name": "Smart TV On",
      "actions": [
        {
          "alias": "Set activity state",
          "action": "harmonium.set_activity",
          "data": {
            "activity": "watch_smart"
          }
        },
        {
          "alias": "Cold start only: wake the Samsung",
          "if": [
            {
              "condition": "state",
              "entity_id": "media_player.sts_samsung_q90_porch",
              "state": "off"
            }
          ],
          "then": [
            {
              "alias": "Wake TV via wired WOL (reliable from standby)",
              "action": "button.press",
              "continue_on_error": true,
              "target": {
                "entity_id": "button.samsung_wired_wol_d4_9d_c0_2c_e5_bf"
              }
            },
            {
              "alias": "Wake TV via remote entity (best effort)",
              "action": "remote.turn_on",
              "continue_on_error": true,
              "target": {
                "entity_id": "remote.sts_samsung_q90_porch"
              }
            },
            {
              "alias": "Wait for the TV to report on (up to 6s)",
              "wait_for_trigger": [
                {
                  "trigger": "state",
                  "entity_id": "media_player.sts_samsung_q90_porch",
                  "to": "on"
                }
              ],
              "timeout": {
                "seconds": 6
              },
              "continue_on_timeout": true
            },
            {
              "alias": "Let the TV finish waking before the source switch",
              "delay": {
                "seconds": 1
              }
            }
          ]
        },
        {
          "alias": "Open Prime Video (on a warm start this switch IS the point)",
          "action": "media_player.select_source",
          "continue_on_error": true,
          "data": {
            "source": "Prime Video"
          },
          "target": {
            "entity_id": "media_player.sts_samsung_q90_porch"
          }
        }
      ],
      "room": "porch"
    },
    "music_on": {
      "name": "Music On",
      "actions": [
        {
          "alias": "Set activity state",
          "action": "harmonium.set_activity",
          "data": {
            "activity": "music"
          }
        }
      ],
      "room": "porch"
    },
    "music_stop": {
      "name": "Music Stop",
      "actions": [
        {
          "alias": "Set activity state",
          "action": "harmonium.set_activity",
          "data": {
            "activity": "off"
          }
        },
        {
          "alias": "Stop basement Sonos (best effort)",
          "action": "media_player.media_stop",
          "continue_on_error": true,
          "target": {
            "entity_id": "media_player.ma_sonos_basement"
          }
        }
      ],
      "room": "porch"
    },
    "all_off": {
      "name": "All Off",
      "actions": [
        {
          "alias": "Set activity state",
          "action": "harmonium.set_activity",
          "data": {
            "activity": "off"
          }
        },
        {
          "alias": "TV off (best effort)",
          "action": "media_player.turn_off",
          "continue_on_error": true,
          "target": {
            "entity_id": "media_player.sts_samsung_q90_porch"
          }
        },
        {
          "alias": "Stop basement Sonos (best effort \u2014 Fire TV NEVER touched, ARC soundbar is the TV's)",
          "action": "media_player.media_stop",
          "continue_on_error": true,
          "target": {
            "entity_id": "media_player.ma_sonos_basement"
          }
        }
      ],
      "room": "porch"
    }
  },
