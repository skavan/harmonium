{
	"global": {
		"debug": false,
		"activity_select": "select.harmonium_porch_activity",
		"buttons": {
			"vol_up": {
				"service": "media_player.volume_up",
				"entity": "$context.volume"
			},
			"vol_down": {
				"service": "media_player.volume_down",
				"entity": "$context.volume"
			},
			"menu_hold": {
				"navigate": "apps"
			}
		},
		"room": "Porch",
		"main_home": "overview",
		"confirm_switch": true
	},
	"home_screen": "porch",
	"screen_order": ["porch", "tv", "music", "comfort"],
	"view": {
		"name": "Porch",
		"class": "room",
		"type": "hub",
		"view_kind": "room hub",
		"room": true,
		"parent": "overview",
		"context": {
			"volume": "media_player.ma_soundbar_porch"
		},
		"banner": {
			"image": "/local/images/Porch_Render.jpg",
			"image_opacity": 0.5,
			"height": "230px",
			"min_height": "150px",
			"show_time": true,
			"rooms_screen": "overview"
		},
		"grid": {
			"columns": 1
		},
		"sections": [
			{
				"tiles": [
					{
						"id": "acts",
						"type": "activities",
						"room": "porch"
					}
				],
				"hero_label": "Activities",
				"role": "activities"
			},
			{
				"columns": 3,
				"tiles": [
					{
						"id": "p_netflix",
						"type": "preset",
						"label": "Netflix",
						"icon": "material:movie",
						"activity": "watch_firetv",
						"action": {
							"service": "media_player.select_source",
							"target": "$context.media_player",
							"data": {
								"source": "Netflix"
							}
						}
					},
					{
						"id": "p_ytv",
						"type": "preset",
						"label": "YouTube TV",
						"icon": "material:live_tv",
						"activity": "watch_firetv",
						"action": {
							"service": "media_player.select_source",
							"target": "$context.media_player",
							"data": {
								"source": "YouTube TV"
							}
						}
					},
					{
						"id": "p_dim",
						"type": "preset",
						"label": "Porch 30%",
						"icon": "material:lightbulb",
						"action": {
							"service": "light.turn_on",
							"target": "light.porch_lights",
							"data": {
								"brightness_pct": 30
							}
						}
					}
				],
				"hero_label": "Presets",
				"title": "Presets",
				"role": "presets"
			},
			{
				"tiles": [
					{
						"id": "grp_hvac",
						"type": "group",
						"label": "HVAC & Lights",
						"icon": "material:layers",
						"target": "comfort"
					}
				],
				"hero_label": "Devices",
				"title": "Devices",
				"role": "devices"
			}
		]
	},
	"activities": {
		"watch_firetv": {
			"name": "Watch Fire TV",
			"icon": "material:live_tv",
			"color": "#d97b3a",
			"start": "sequence:firetv_on",
			"confirm_end": true,
			"context": {
				"media_player": "media_player.fire_tv_family_192_168_1_65",
				"dpad": "remote.fire_tv_family_192_168_1_65",
				"power": "media_player.sts_samsung_q90_porch",
				"volume": "media_player.sts_samsung_q90_porch",
				"volume_level": "media_player.ma_soundbar_porch"
			},
			"controls": {
				"navigation": "$context.dpad",
				"back": {
					"command": "back",
					"entity": "$context.dpad"
				},
				"home": {
					"command": "home",
					"entity": "$context.dpad"
				},
				"power": {
					"service": "media_player.toggle",
					"entity": "$context.power"
				},
				"volume": "$context.volume"
			},
			"state": {
				"entities": ["media_player.fire_tv_family_192_168_1_65", "media_player.sts_samsung_q90_porch"],
				"on": {
					"all": [
						{
							"entity": "media_player.sts_samsung_q90_porch",
							"state": "on"
						},
						{
							"entity": "media_player.sts_samsung_q90_porch",
							"attribute": "source",
							"in": ["Fire TV", "TV/HDMI"]
						}
					]
				}
			},
			"screen": "tv",
			"room_view": "porch"
		},
		"watch_smart": {
			"name": "Watch Smart TV",
			"icon": "material:tv",
			"color": "#e89b17",
			"start": "sequence:smart_tv_on",
			"confirm_end": true,
			"context": {
				"media_player": "media_player.sts_samsung_q90_porch",
				"dpad": "remote.sts_samsung_q90_porch",
				"power": "media_player.sts_samsung_q90_porch",
				"volume": "media_player.sts_samsung_q90_porch",
				"volume_level": "media_player.ma_soundbar_porch",
				"dpad_commands": {
					"up": "KEY_UP",
					"down": "KEY_DOWN",
					"left": "KEY_LEFT",
					"right": "KEY_RIGHT",
					"select": "KEY_ENTER",
					"back": "KEY_RETURN",
					"home": "KEY_HOME",
					"menu": "KEY_MENU",
					"info": "KEY_INFO",
					"ch_up": "KEY_CHUP",
					"ch_down": "KEY_CHDOWN"
				}
			},
			"controls": {
				"navigation": "$context.dpad",
				"back": {
					"command": "back",
					"entity": "$context.dpad"
				},
				"home": {
					"command": "home",
					"entity": "$context.dpad"
				},
				"power": {
					"service": "media_player.toggle",
					"entity": "$context.power"
				},
				"volume": "$context.volume"
			},
			"state": {
				"entities": ["media_player.sts_samsung_q90_porch"],
				"on": {
					"all": [
						{
							"entity": "media_player.sts_samsung_q90_porch",
							"state": "on"
						},
						{
							"entity": "media_player.sts_samsung_q90_porch",
							"attribute": "source",
							"not_in": ["Fire TV", "Unknown (HDMI 1)", "TV/HDMI"]
						}
					]
				}
			},
			"screen": "tv",
			"room_view": "porch"
		},
		"music": {
			"name": "Listen to Music",
			"icon": "material:music_note",
			"color": "#1e8a82",
			"start": "sequence:music_on",
			"stop": "sequence:music_stop",
			"context": {
				"media_player": "media_player.ma_sonos_basement",
				"power": "media_player.ma_sonos_basement",
				"volume": "media_player.ma_sonos_basement"
			},
			"controls": {
				"power": {
					"service": "media_player.toggle",
					"entity": "$context.power"
				},
				"volume": "$context.volume"
			},
			"state": {
				"entities": ["media_player.ma_sonos_basement"],
				"on": {
					"any_state": ["on", "playing", "paused", "buffering"]
				}
			},
			"screen": "music",
			"room_view": "porch"
		},
		"off": {
			"name": "All Off",
			"icon": "material:power_settings_new",
			"start": "sequence:all_off",
			"confirm_end": true,
			"room_view": "porch"
		}
	},
	"sequences": {
		"firetv_on": {
			"name": "Fire TV On",
			"actions": [
				{
					"alias": "Set activity state",
					"action": "harmonium.set_activity",
					"data": {
						"activity": "watch_firetv"
					}
				},
				{
					"alias": "Wake Fire TV if asleep (non-disruptive, best effort)",
					"action": "media_player.turn_on",
					"continue_on_error": true,
					"target": {
						"entity_id": "media_player.fire_tv_family_192_168_1_65"
					}
				},
				{
					"alias": "Cold start only: wake the Samsung",
					"if": [
						{
							"condition": "state",
							"entity_id": "media_player.sts_samsung_q90_porch",
							"state": "off"
						}
					],
					"then": [
						{
							"alias": "Wake TV via wired WOL (reliable from standby)",
							"action": "button.press",
							"continue_on_error": true,
							"target": {
								"entity_id": "button.samsung_wired_wol_d4_9d_c0_2c_e5_bf"
							}
						},
						{
							"alias": "Wake TV via remote entity (best effort)",
							"action": "remote.turn_on",
							"continue_on_error": true,
							"target": {
								"entity_id": "remote.sts_samsung_q90_porch"
							}
						},
						{
							"alias": "Wait for the TV to report on (up to 6s)",
							"wait_for_trigger": [
								{
									"trigger": "state",
									"entity_id": "media_player.sts_samsung_q90_porch",
									"to": "on"
								}
							],
							"timeout": {
								"seconds": 6
							},
							"continue_on_timeout": true
						},
						{
							"alias": "Let the TV finish waking before the source switch",
							"delay": {
								"seconds": 1
							}
						}
					]
				},
				{
					"alias": "Switch TV input ONLY if not already on the Fire TV",
					"if": [
						{
							"condition": "not",
							"conditions": [
								{
									"condition": "state",
									"entity_id": "media_player.sts_samsung_q90_porch",
									"attribute": "source",
									"state": ["Fire TV", "TV/HDMI"]
								}
							]
						}
					],
					"then": [
						{
							"alias": "Switch TV input to Fire TV (best effort)",
							"action": "media_player.select_source",
							"continue_on_error": true,
							"data": {
								"source": "Fire TV"
							},
							"target": {
								"entity_id": "media_player.sts_samsung_q90_porch"
							}
						}
					]
				}
			],
			"room": "porch"
		},
		"smart_tv_on": {
			"name": "Smart TV On",
			"actions": [
				{
					"alias": "Set activity state",
					"action": "harmonium.set_activity",
					"data": {
						"activity": "watch_smart"
					}
				},
				{
					"alias": "Cold start only: wake the Samsung",
					"if": [
						{
							"condition": "state",
							"entity_id": "media_player.sts_samsung_q90_porch",
							"state": "off"
						}
					],
					"then": [
						{
							"alias": "Wake TV via wired WOL (reliable from standby)",
							"action": "button.press",
							"continue_on_error": true,
							"target": {
								"entity_id": "button.samsung_wired_wol_d4_9d_c0_2c_e5_bf"
							}
						},
						{
							"alias": "Wake TV via remote entity (best effort)",
							"action": "remote.turn_on",
							"continue_on_error": true,
							"target": {
								"entity_id": "remote.sts_samsung_q90_porch"
							}
						},
						{
							"alias": "Wait for the TV to report on (up to 6s)",
							"wait_for_trigger": [
								{
									"trigger": "state",
									"entity_id": "media_player.sts_samsung_q90_porch",
									"to": "on"
								}
							],
							"timeout": {
								"seconds": 6
							},
							"continue_on_timeout": true
						},
						{
							"alias": "Let the TV finish waking before the source switch",
							"delay": {
								"seconds": 1
							}
						}
					]
				},
				{
					"alias": "Open Prime Video (on a warm start this switch IS the point)",
					"action": "media_player.select_source",
					"continue_on_error": true,
					"data": {
						"source": "Prime Video"
					},
					"target": {
						"entity_id": "media_player.sts_samsung_q90_porch"
					}
				}
			],
			"room": "porch"
		},
		"music_on": {
			"name": "Music On",
			"actions": [
				{
					"alias": "Set activity state",
					"action": "harmonium.set_activity",
					"data": {
						"activity": "music"
					}
				}
			],
			"room": "porch"
		},
		"music_stop": {
			"name": "Music Stop",
			"actions": [
				{
					"alias": "Set activity state",
					"action": "harmonium.set_activity",
					"data": {
						"activity": "off"
					}
				},
				{
					"alias": "Stop basement Sonos (best effort)",
					"action": "media_player.media_stop",
					"continue_on_error": true,
					"target": {
						"entity_id": "media_player.ma_sonos_basement"
					}
				}
			],
			"room": "porch"
		},
		"all_off": {
			"name": "All Off",
			"actions": [
				{
					"alias": "Set activity state",
					"action": "harmonium.set_activity",
					"data": {
						"activity": "off"
					}
				},
				{
					"alias": "TV off (best effort)",
					"action": "media_player.turn_off",
					"continue_on_error": true,
					"target": {
						"entity_id": "media_player.sts_samsung_q90_porch"
					}
				},
				{
					"alias": "Stop basement Sonos (best effort — Fire TV NEVER touched, ARC soundbar is the TV's)",
					"action": "media_player.media_stop",
					"continue_on_error": true,
					"target": {
						"entity_id": "media_player.ma_sonos_basement"
					}
				}
			],
			"room": "porch"
		}
	}
}
