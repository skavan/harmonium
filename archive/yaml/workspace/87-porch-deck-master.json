		"sequences": {
			"deck_watch_projector_start": {
				"name": "Watch Projector — Start (generated)",
				"room": "deck",
				"actions": [
					{
						"alias": "Set activity state",
						"action": "harmonium.set_activity",
						"data": {
							"activity": "new_room_watch_projector"
						}
					},
					{
						"alias": "Wake Pergola Projector if asleep (best effort)",
						"action": "homeassistant.turn_on",
						"continue_on_error": true,
						"target": {
							"entity_id": "media_player.deck_hisense_projector"
						}
					},
					{
						"alias": "Switch media_player.ma_sonos_deck to TV ONLY if needed",
						"if": [
							{
								"condition": "not",
								"conditions": [
									{
										"condition": "state",
										"entity_id": "media_player.ma_sonos_deck",
										"attribute": "source",
										"state": "TV"
									}
								]
							}
						],
						"then": [
							{
								"alias": "Set input to TV (best effort)",
								"action": "media_player.select_source",
