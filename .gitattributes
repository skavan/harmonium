# Line-ending contract — CRITICAL for forkers on any OS.
# Windows batch scripts MUST check out as CRLF: cmd.exe mis-parses
# goto labels and multi-line parens in bare-LF .bat files. Everything
# else is normal text (LF in the repo, your autocrlf choice on disk).
* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# binaries — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.tgz  binary
